{
  "action": {
    "default_title": "Open Application Tracker 2.1 dock"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdayjobs-impl.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.myworkday.com/*"
      ],
      "js": [
        "content-scripts/apply-network.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-scripts/dock-apply.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "ai-apply/src/native-chat-search.js",
        "ai-apply/src/sidebar-history.js",
        "ai-apply/src/deepseek-routes.js",
        "ai-apply/src/deepseek-consent.js",
        "ai-apply/src/deepseek-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "ai-apply/src/native-chat-search.js",
        "ai-apply/src/build-info.js",
        "ai-apply/src/workspace-shortcut-keys.js",
        "ai-apply/src/sidebar-history.js",
        "ai-apply/src/chat-history.js",
        "ai-apply/src/chatgpt-frame.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "description": "Track job applications, autofill forms, and prepare tailored resumes in one workspace.",
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "name": "Application Tracker 2.1",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "sidePanel",
    "downloads",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "downloads.open"
  ],
  "short_name": "Application Tracker 2.1",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "version": "2.1.31",
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png",
        "icons/icon.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "ai-apply/index.html",
        "ai-apply/profile.html",
        "preview.html",
        "ai-apply/src/*",
        "ai-apply/assets/*",
        "ai-apply/vendor/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "commands": {
    "read-job-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Read the current job page in Apply to Job"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open Application Tracker dock"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'; base-uri 'none'; frame-src 'self' blob: https://chatgpt.com https://chat.deepseek.com;"
  },
  "version_name": "2.1.31"
}
